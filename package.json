{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "check": "biome check src",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen http://localhost:3000",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@next/third-parties": "16.4.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wterm/dom": "0.5.10",
    "@wterm/just-bash": "0.5.10",
    "@wterm/react": "0.5.10",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "highlight.js": "11.12.0",
    "hono": "4.13.18",
    "html-react-parser": "6.1.9",
    "jotai": "3.0.2",
    "just-bash": "3.6.0",
    "kiso.css": "1.2.4",
    "microcms-js-sdk": "3.6.0",
    "motion": "14.13.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "resend": "6.38.0",
    "schema-dts": "2.1.0",
    "swr": "2.5.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome format --write",
      "biome lint"
    ],
    "src/**/*.css": [
      "biome format --write",
      "biome lint"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "18.0.10",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "sass": "1.108.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "guarded-fetch": {
      "undici": "7.30.2"
    }
  }
}
